{
  "name": "saathi",
  "version": "0.1.0",
  "private": true,
  "description": "Saathi \u2014 patient companion: one app for patients, carers and care teams. Web app + Capacitor shell for iOS/Android, Supabase backend.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --serve",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/test.mjs",
    "import:drug": "node scripts/import-openfda.mjs",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "typecheck:offline": "tsc --noEmit -p tsconfig.offline.json",
    "seed:supabase": "node scripts/seed-supabase.mjs",
    "assets": "npx @capacitor/assets generate --iconBackgroundColor \"#0F2729\" --splashBackgroundColor \"#0F2729\""
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "jszip": "3.10.1",
    "@capacitor/core": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.0",
    "@capacitor/push-notifications": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@capacitor-community/text-to-speech": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}